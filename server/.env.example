# Copy to server/.env and fill in what you need. Every setting is optional.

# ── Server ───────────────────────────────────────────────────────────
# PORT=4000
# HOST=127.0.0.1            # loopback only; set 0.0.0.0 only behind HTTPS
# DATA_DIR=/data            # folder for data.json, uploads/ and backups/ (cloud: a mounted volume)
# DATA_FILE=data.json       # journal file name inside DATA_DIR (or server/)
# TRUST_PROXY=1             # behind a host's HTTPS proxy (Railway, Render, Fly…): secure cookies, real IPs
# TZ=Asia/Kolkata           # your time zone: streak days and reminder times use it

# ── Public deployments: who may create accounts ──────────────────────
# MAX_USERS=1               # first account can sign up, then registration closes
# ALLOW_SIGNUP=false        # close registration entirely
# ENABLE_ADMIN=1            # dev-only DB viewer at /admin (localhost only)

# ── AI (first configured provider wins; falls back to local heuristics) ─
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=           # aistudio.google.com/apikey
# GEMINI_MODEL=gemini-flash-latest
# GROQ_API_KEY=
# OPENAI_API_KEY=

# ── WebAuthn / passkeys (change for production) ──────────────────────
# Passkeys follow the HTTPS address you open the app on. Pin them only if needed:
# RP_ID=journal.example.com
# WEBAUTHN_ORIGIN=https://journal.example.com

# ── Email reminders (optional, needs `npm i nodemailer`) ─────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ── SMS reminders via Twilio (optional, needs `npm i twilio`) ────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE=
